# Copy to backend/.env. Never commit real credentials.
APP_ENV=development
# Use your project URL and publishable key (legacy anon key also works).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Backend only: needed for protected extraction-job writes, never sent to Flutter.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=receipts
# Backend only. API billing/credits must be enabled for this key's project.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ASK_SNAP_MODEL=gpt-5-mini
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=45
EXTRACTION_DAILY_LIMIT=50
MAX_UPLOAD_BYTES=6291456
# JSON array. Mobile clients do not need CORS; add exact web origins when integrating.
CORS_ORIGINS=[]
